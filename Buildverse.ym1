name: Build APK
on: [push]
jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Unzip code
        run: unzip../buildverse.zip -d buildverse
      - name: Install Buildozer
        run: pip install buildozer cython
      - name: Build APK
        run: cd buildverse && buildozer android debug
      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: test-apk
          path: buildverse/bin/*.apk
